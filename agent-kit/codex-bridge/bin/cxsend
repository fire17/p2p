#!/usr/bin/env python3
"""cxsend - message a LIVE Codex session through Codex's own app-server daemon (peerbridge v0.1).

  cxsend probe [--cwd DIR]                      headless end-to-end proof, NO TUI needed: creates an ephemeral
                                                read-only thread on the daemon (thread/start), injects a turn,
                                                waits for the model's reply, prints timings. Uses a tiny model turn.
  cxsend list [--cwd PREFIX] [--all]            live Codex threads you may reach (--all: also unexposed ones)
  cxsend send <thread-id|name|cwd-basename> <text...> [--from NAME] [--raw] [--file PATH]
                                                inject as a user turn: wakes an idle thread (new turn),
                                                steers a busy one (folded into the running turn)
Only threads exposed by this machine's owner are reachable (~/.peerbridge/policy.json, edited with
`pb expose` / `pb off`; default: nothing exposed). Works wherever `codex` 0.162+ runs: direct to ~/.codex/app-server-control/app-server-control.sock when it
exists, else through `codex app-server proxy` (Codex picks the OS transport; set
PEERBRIDGE_CODEX_TRANSPORT=proxy to force). Python 3.9+, stdlib only.
"""
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
for cand in (os.path.join(HERE, "..", "peerbridge"), os.path.join(HERE, "..", "lib", "peerbridge"), HERE):
    if os.path.exists(os.path.join(cand, "cxrpc.py")):
        sys.path.insert(0, os.path.abspath(cand))
        break
from cxrpc import CodexRPC, RPCError  # noqa: E402
import policy  # noqa: E402


def threads(rpc, cwd_prefix=None, include_hidden=False):
    out = []
    pol = policy.load()
    for tid in rpc.call("thread/loaded/list", {}).get("data", []):
        try:
            t = rpc.call("thread/read", {"threadId": tid})["thread"]
        except Exception:
            continue
        if t.get("ephemeral"):
            continue
        cwd = os.path.realpath(t.get("cwd") or "")
        if cwd_prefix and not (cwd == cwd_prefix or cwd.startswith(cwd_prefix.rstrip("/") + "/")):
            continue
        t["_exposed"] = policy.allowed(t["id"], t.get("cwd"), pol)
        if t["_exposed"] or include_hidden:
            out.append(t)
    return out


def probe(rpc, cwd):
    import queue as _q
    events = _q.Queue()
    rpc.on_notify = lambda m, p: events.put((time.time(), m, p))
    t0 = time.time()
    try:
        th = rpc.call("thread/start", {"cwd": cwd, "ephemeral": True, "sandbox": "read-only",
                                       "approvalPolicy": "never", "threadSource": "user"}, timeout=60)["thread"]
    except Exception as e:
        sys.exit(f"cxsend probe: thread/start failed: {e}")
    tid = th["id"]
    t1 = time.time()
    print(f"thread/start ok: {tid} in {(t1 - t0) * 1000:.0f} ms (ephemeral, read-only, cwd={cwd})")
    nonce = os.urandom(3).hex()
    text = f"peerbridge probe: reply with exactly PROBE-OK-{nonce} and nothing else. Do not run any tools."
    rpc.call("turn/start", {"threadId": tid, "input": [{"type": "text", "text": text}]}, timeout=30)
    t2 = time.time()
    print(f"turn/start ok in {(t2 - t1) * 1000:.0f} ms")
    reply, active, done = None, None, None
    deadline = t2 + 120
    while time.time() < deadline and not done:
        try:
            ts, m, p = events.get(timeout=1)
        except _q.Empty:
            continue
        if p.get("threadId") not in (None, tid):
            continue
        if m == "turn/started" and not active:
            active = ts
        if m == "item/completed":
            it = p.get("item") or {}
            if it.get("type") in ("agentMessage", "AgentMessage") and f"PROBE-OK-{nonce}" in json.dumps(it):
                reply = ts
        if m == "turn/completed":
            done = ts
    ok = bool(reply)
    print(f"turn started +{(active - t2):.2f}s" if active else "turn/started: not seen")
    print(f"reply PROBE-OK-{nonce}: {'+%.2fs' % (reply - t2) if reply else 'NOT seen within 120 s'}")
    print("RESULT:", "PASS (daemon accepted thread + injected turn + model replied)" if ok else "FAIL")
    sys.exit(0 if ok else 1)


def status(t):
    s = t.get("status") or {}
    return s.get("type", "?") + ("(" + ",".join(s["activeFlags"]) + ")" if s.get("activeFlags") else "")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    cwdp = None
    if "--cwd" in a:
        i = a.index("--cwd"); cwdp = os.path.realpath(a[i + 1]); del a[i:i + 2]
    if policy.load().get("off"):
        sys.exit("cxsend: peerbridge is OFF on this machine (kill switch); `pb on` to re-enable")
    try:
        rpc = CodexRPC(client_name="cxsend", version="0.2.2")
    except ConnectionError as e:
        sys.exit(f"cxsend: cannot reach the Codex app-server daemon: {e}")
    if a[0] == "probe":
        return probe(rpc, cwdp or os.getcwd())
    if a[0] == "list":
        show_all = "--all" in a
        for t in threads(rpc, cwdp, include_hidden=show_all):
            flag = "" if t["_exposed"] else "  (NOT exposed)"
            print(f"{t['id']}  {status(t):<10} {t.get('cwd', '')}  {t.get('name') or ''}{flag}")
        return
    if a[0] != "send" or len(a) < 2:
        sys.exit(__doc__)
    frm, raw, text = os.environ.get("CXSEND_FROM") or "", False, None
    args = a[2:]
    if "--from" in args:
        i = args.index("--from"); frm = args[i + 1]; del args[i:i + 2]
    if "--raw" in args:
        args.remove("--raw"); raw = True
    if "--file" in args:
        i = args.index("--file"); text = open(args[i + 1], encoding="utf-8").read(); del args[i:i + 2]
    if text is None:
        text = sys.stdin.read() if args in ([], ["-"]) else " ".join(args)
    if not text.strip():
        sys.exit("cxsend: empty message")
    target = a[1]
    ts = threads(rpc, cwdp)
    m = [t for t in ts if t["id"] == target] or [t for t in ts if (t.get("name") or "") == target] \
        or [t for t in ts if os.path.basename((t.get("cwd") or "").rstrip("/")) == target]
    if len(m) != 1:
        hidden = [t for t in threads(rpc, cwdp, include_hidden=True) if target in (t["id"], t.get("name"))]
        if hidden and not m:
            sys.exit(f"cxsend: '{target}' is live but NOT exposed by this machine's owner (pb expose --thread {hidden[0]['id']}).")
        sys.exit(f"cxsend: expected one live exposed thread for '{target}', found {len(m)}. Try `cxsend list`.")
    t = m[0]
    if not raw:
        who = frm or os.environ.get("USER", "agent")
        text = (f'<cross-session-message from-name="{who}" via="cxsend">\n{text}\n</cross-session-message>\n'
                f"(Sent by another agent session, not typed by your user.)")
    before = status(t)
    t0 = time.time()
    try:
        r = rpc.call("turn/start", {"threadId": t["id"], "input": [{"type": "text", "text": text}]})
    except RPCError as e:
        sys.exit(f"cxsend: Codex refused: {e}")
    dt = (time.time() - t0) * 1000
    how = "steered into running turn" if before.startswith("active") else "started new turn"
    print(f"injected into {t['id']} ({t.get('cwd')}): {how}, turn {r['turn']['id']}, {dt:.0f} ms, transport={rpc.mode}")


if __name__ == "__main__":
    main()
