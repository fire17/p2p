#!/usr/bin/env python3
"""pb - peerbridge command for Codex sessions (and humans).

  pb list [--json]                       live peers: Claude Code sessions + bridged Codex threads
  pb send <to> <text...> [--notify-idle] [--wait SEC] [--file PATH | -]
                                         message a peer (name, "name [ref]", uds:address, ref, sessionId)
  pb whoami                              this Codex thread's peer identity
  pb name <new-name>                     rename this Codex thread's peer
  pb ensure | status | stop              hub lifecycle
  pb policy                              show who may be reached (local file ~/.peerbridge/policy.json)
  pb expose [--thread ID | --cwd PATH | --all]   make a Codex thread reachable (default: this thread)
  pb hide   [--thread ID | --cwd PATH | --all]   undo expose (--all returns to opt-in mode)
  pb off | pb on                         kill switch: withdraw every Codex peer and refuse all injection
  pb doctor                              ASCII health report: platform, codex + daemon, transport, policy, hub
"""
from __future__ import annotations

import json
import os
import signal
import socket
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
for cand in (os.path.join(HERE, "..", "peerbridge"), os.path.join(HERE, "..", "lib", "peerbridge")):
    if os.path.exists(os.path.join(cand, "ccpeer.py")):
        sys.path.insert(0, os.path.abspath(cand))
        PKG = os.path.abspath(cand)
        break
else:
    sys.exit("pb: cannot find the peerbridge package next to this script")
import ccpeer  # noqa: E402
import policy  # noqa: E402

HOME = ccpeer.STATE_DIR
CTL = os.path.join(HOME, "hub.sock")
RECEIPTS = os.path.join(HOME, "receipts.jsonl")


def die(msg: str, code: int = 1):
    print(f"pb: {msg}", file=sys.stderr)
    sys.exit(code)


class Sandboxed(Exception):
    pass


def ctl(req: dict, timeout: float = 20.0) -> dict | None:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(CTL)
        s.sendall((json.dumps(req) + "\n").encode())
        data = b""
        while b"\n" not in data:
            c = s.recv(65536)
            if not c:
                break
            data += c
        s.close()
        return json.loads(data.split(b"\n")[0])
    except PermissionError:
        raise Sandboxed()
    except OSError as e:
        if getattr(e, "errno", None) == 1:  # EPERM: Codex sandbox blocks the socket
            raise Sandboxed()
        return None
    except Exception:
        return None


def ensure(quiet: bool = False) -> dict:
    r = ctl({"cmd": "ping"}, 3)
    if r and r.get("ok"):
        return r
    os.makedirs(HOME, exist_ok=True)
    log = open(os.path.join(HOME, "hub.out"), "a")
    subprocess.Popen([sys.executable, os.path.join(PKG, "hub.py")], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True, close_fds=True)
    for _ in range(50):
        time.sleep(0.1)
        r = ctl({"cmd": "ping"}, 2)
        if r and r.get("ok"):
            if not quiet:
                print(f"hub started pid={r['pid']}")
            return r
    die("hub did not come up; see ~/.peerbridge/hub.log and hub.out")


def me(required: bool = True) -> dict | None:
    tid = os.environ.get("CODEX_THREAD_ID") or os.environ.get("PEERBRIDGE_THREAD_ID")
    if not tid:
        if required:
            die("not inside a Codex session (CODEX_THREAD_ID unset). Claude sessions use their native SendMessage tool.")
        return None
    path = os.path.join(HOME, "threads", f"{tid}.json")
    for i in range(40):
        try:
            st = json.load(open(path))
            if ccpeer.pid_alive(st.get("stubPid", 0)):
                return st
        except Exception:
            pass
        if i == 0:
            ensure(quiet=True)
            ctl({"cmd": "resync"}, 10)
        time.sleep(0.1)
    if required:
        die(f"this Codex thread ({tid}) is not bridged yet; is the Codex app-server daemon running? see `pb status`")
    return None


def from_mode(st: dict) -> str:
    sys.path.insert(0, PKG)
    from hub import approval_of  # noqa: E402
    return "bypass" if approval_of(st.get("rollout")) == "never" else "prompting"


def cmd_list(args):
    recs = ccpeer.records()
    mine = me(required=False)
    if "--json" in args:
        print(json.dumps([{k: r.get(k) for k in ("name", "ref", "address", "status", "cwd", "entrypoint", "harness", "sessionId", "pid")} for r in recs], indent=1))
        return
    for r in recs:
        harness = r.get("harness") or ("codex" if r.get("entrypoint") == "codex" else "claude")
        star = " (you)" if mine and r["address"] == mine.get("address") else ""
        print(f"{r['name']:<28} [{r['ref'][:6]}] {harness:<6} {r.get('status', '?'):<7} {r.get('cwd', '')}{star}")
        print(f"{'':<28}   {r['address']}")


def cmd_send(args):
    notify = "--notify-idle" in args
    args = [a for a in args if a != "--notify-idle"]
    wait = 1.5
    if "--wait" in args:
        i = args.index("--wait")
        try:
            wait = float(args[i + 1])
        except (IndexError, ValueError):
            die("--wait needs a number of seconds")
        del args[i:i + 2]
    text = None
    if "--file" in args:
        i = args.index("--file")
        text = open(args[i + 1], encoding="utf-8").read()
        del args[i:i + 2]
    if not args:
        die("usage: pb send <to> <text...>")
    to, rest = args[0], args[1:]
    if text is None:
        text = sys.stdin.read() if rest == ["-"] or (not rest and not sys.stdin.isatty()) else " ".join(rest)
    if not text.strip() and not notify:
        die("empty message")
    if len(text.encode("utf-8")) > 900_000:
        die("message too large (> 900 KB); Claude Code caps a frame at 1 MiB. Send a file path instead.")
    st = me()
    start = os.path.getsize(RECEIPTS) if os.path.exists(RECEIPTS) else 0
    t0 = time.time()
    try:
        r = ctl({"cmd": "send", "threadId": st["threadId"], "to": to, "text": text, "notifyIdle": notify}, 25)
    except Sandboxed:
        return send_via_output(st, to, text, notify)
    if not r:
        die("hub unreachable (pb status / pb ensure)")
    if not r.get("ok"):
        die(r.get("error", "send failed"))
    msg_id = r["msgId"]
    print(f"sent {msg_id} -> {r['to']} [{r['ref']}] ({r.get('toHarness')}) as {r['as']} from-mode={r['fromMode']} "
          f"in {(time.time() - t0) * 1000:.0f} ms")
    deadline = t0 + wait
    while time.time() < deadline:
        if os.path.exists(RECEIPTS):
            with open(RECEIPTS) as fh:
                fh.seek(start)
                for line in fh:
                    try:
                        rc = json.loads(line)
                    except Exception:
                        continue
                    if rc.get("msgId") == msg_id:
                        print(f"NOT DELIVERED ({rc.get('status')}{'/' + rc['detail'] if rc.get('detail') else ''}) after "
                              f"{time.time() - t0:.2f}s - {rc.get('reason')}")
                        sys.exit(2)
        time.sleep(0.1)
    print("accepted: written into the peer's inbox and no hold/refusal came back "
          "(Claude Code and peerbridge send receipts only for held/refused/expired; a later notice would be injected here).")


def send_via_output(st: dict, to: str, text: str, notify: bool) -> None:
    """Sandbox path: no socket is reachable, so print ONE signed marker line. Command output always lands in this
    thread's rollout; the hub tails it, checks the HMAC with this thread's key (threads/<tid>.json, 0600),
    de-duplicates by id and sends from this thread's stub. Nothing is written inside the sandbox."""
    import base64, hashlib, hmac, uuid
    key = st.get("sendKey")
    if not key:
        die("hub is older than v0.2.1 (no sendKey); cannot send from inside the sandbox", 3)
    matches = [r for r in ccpeer.resolve(to) if r["address"] != st.get("address")]
    if len(matches) != 1:
        cands = ", ".join(f"{r['name']} [{r['ref'][:6]}]" for r in matches) or "none"
        die(f"expected exactly one live peer for '{to}', found {len(matches)}: {cands}. Use `pb list`.")
    req = {"v": 1, "id": str(uuid.uuid4()), "to": to, "notify": notify, "ts": time.time()}
    if len(text.encode("utf-8")) <= 1500:
        req["text"] = text
    else:  # long text: a temp file the hub reads (sandbox usually allows writing $TMPDIR/workspace)
        import tempfile
        for d in (os.environ.get("TMPDIR"), "/tmp", os.getcwd()):
            try:
                fd, path = tempfile.mkstemp(prefix="pb-out-", suffix=".txt", dir=d)
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(text)
                req["file"], req["sha"] = path, hashlib.sha256(text.encode()).hexdigest()
                break
            except Exception:
                continue
        else:
            die("message too long for the sandbox channel (>1500 bytes) and no writable temp dir; shorten it", 3)
    b64 = base64.urlsafe_b64encode(json.dumps(req, separators=(",", ":")).encode()).decode().rstrip("=")
    mac = hmac.new(key.encode(), b64.encode(), hashlib.sha256).hexdigest()
    print(f"@@PBSEND1.{b64}.{mac}@@")
    print(f"queued {req['id']} -> {matches[0]['name']} via the Codex output channel (sandbox blocks sockets): "
          f"the peerbridge hub sends it from your peer address about 0.2 s after this command finishes. "
          f"No escalation needed. If it fails, a [peerbridge] notice is injected into this thread.")


def cmd_whoami(args):
    st = dict(me())
    st.pop("sendKey", None)
    st["fromMode"] = from_mode(st)
    print(json.dumps(st, indent=1))


def cmd_name(args):
    if not args:
        die("usage: pb name <new-name>")
    st = me()
    r = ctl({"cmd": "rename", "threadId": st["threadId"], "name": " ".join(args)})
    if not r or not r.get("ok"):
        die((r or {}).get("error", "hub unreachable"))
    print(f"renamed to {r['name']}")


def cmd_status(args):
    r = ctl({"cmd": "ping"}, 3)
    if not r:
        print("hub: not running")
        sys.exit(1)
    print(json.dumps(r, indent=1))


def cmd_stop(args):
    try:
        pid = int(open(os.path.join(HOME, "hub.lock")).read().strip())
        os.kill(pid, signal.SIGTERM)
        print(f"stopped hub pid={pid}")
    except Exception as e:
        die(f"no hub to stop ({e})")


def _target(args):
    st = me(required=False)
    if "--all" in args:
        return ("all", None)
    if "--thread" in args:
        return ("thread", args[args.index("--thread") + 1])
    if "--cwd" in args:
        return ("cwd", os.path.realpath(args[args.index("--cwd") + 1]))
    if st:
        return ("thread", st["threadId"])
    if os.environ.get("CODEX_THREAD_ID"):
        return ("thread", os.environ["CODEX_THREAD_ID"])
    die("say what to expose: --thread ID | --cwd PATH | --all (or run inside a Codex session)")


def private_app_servers() -> int:
    """Count Codex app-server processes that are NOT the shared managed daemon (desktop app, IDE extension)."""
    try:
        if os.name == "nt":
            argv = ["powershell", "-NoProfile", "-Command",
                    "Get-CimInstance Win32_Process -Filter \"Name='codex.exe'\" | ForEach-Object { $_.CommandLine }"]
        else:
            argv = ["ps", "-axo", "command="]
        out = subprocess.run(argv, capture_output=True, text=True, timeout=15).stdout.splitlines()
    except Exception:
        return 0
    return sum(1 for c in out if " app-server" in c and "--managed-daemon" not in c and " proxy" not in c
               and "daemon " not in c and "--listen" not in c)


def cmd_doctor(args):
    import platform, shutil, socket as _s
    sys.path.insert(0, PKG)
    import cxrpc  # noqa: E402
    out = []
    def row(k, v):
        out.append(f"{k:<22} {v}")
    rel = platform.release()
    if os.name == "nt":
        try:
            build = int(platform.version().split(".")[-1])
            rel = f"11 (build {build})" if build >= 22000 else f"10 (build {build})"
        except Exception:
            pass
    wsl = sys.platform.startswith("linux") and "microsoft" in platform.release().lower()
    row("platform", f"{platform.system()} {rel} ({sys.platform}{', WSL' if wsl else ''})")
    row("python", sys.version.split()[0])
    row("af_unix", "yes" if hasattr(_s, "AF_UNIX") else "no (Windows CPython: proxy transport)")
    codex = shutil.which("codex")
    row("codex", codex or "NOT FOUND on PATH")
    if wsl and codex and codex.startswith("/mnt/"):
        row("FIX (wsl)", "this `codex` is the Windows npm shim via interop and fails without node in WSL; "
            "install a native one inside WSL: install node, then `npm i -g @openai/codex`")
    if codex:
        try:
            v = subprocess.run([codex, "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
            row("codex version", v or "?")
            d = subprocess.run([codex, "app-server", "daemon", "version"], capture_output=True, text=True, timeout=15)
            try:
                dj = json.loads(d.stdout)
                daemon_up = dj.get("status") == "running"
                row("daemon", f"{dj.get('status')} app-server {dj.get('appServerVersion')} backend={dj.get('backend')}")
            except Exception:
                daemon_up = False
                row("daemon", (d.stdout or d.stderr).strip().splitlines()[0] if (d.stdout or d.stderr).strip() else "?")
            priv = private_app_servers()
            if priv:
                row("other app-servers", f"{priv} private (desktop app, IDE extension or a tool; their threads are NOT reachable"
                    + ("; on Windows the desktop app never uses the shared daemon)" if os.name == "nt" else
                       "; launch the app with CODEX_APP_SERVER_USE_LOCAL_DAEMON=1 to share the daemon)"))
            if not daemon_up:
                row("FIX", "open one CLI `codex` session (non-elevated, no -c/--enable/--disable flags) "
                    "or run `codex app-server daemon start`; then `pb doctor` again")
        except Exception as e:
            row("codex version", f"error: {e}")
    row("codex control sock", f"{cxrpc.CONTROL_SOCK} ({'present' if os.path.exists(cxrpc.CONTROL_SOCK) else 'absent'})")
    mode = os.environ.get("PEERBRIDGE_CODEX_TRANSPORT") or ("unix" if hasattr(_s, "AF_UNIX") and os.path.exists(cxrpc.CONTROL_SOCK) else "proxy")
    row("codex transport", mode)
    try:
        rpc = cxrpc.CodexRPC(client_name="pb-doctor", version="0.2.1")
        n = len(rpc.call("thread/loaded/list", {}).get("data", []))
        row("daemon rpc", f"ok, {n} loaded thread(s)")
        rpc.close()
    except Exception as e:
        row("daemon rpc", f"FAIL: {str(e)[:300]}")
    row("cc sessions dir", f"{ccpeer.SESSIONS_DIR} ({'present' if os.path.isdir(ccpeer.SESSIONS_DIR) else 'absent'})")
    row("cc socks dir", ccpeer.socks_dir())
    recs = ccpeer.records()
    row("cc peers", f"{len(recs)} live ({sum(1 for r in recs if r.get('entrypoint') == 'codex')} codex)")
    if os.name == "nt":
        row("NOTE (windows)", "native-Windows Claude peers use named pipes; Claude<->Codex stubs for them arrive in "
            "peerbridge v0.3. Today on Windows: cxsend (Codex inject) works once a shared daemon runs.")
    p = policy.load()
    row("policy", f"expose={p.get('expose')} off={p.get('off')} threads={len(p.get('threads') or [])} cwds={len(p.get('cwds') or [])}")
    try:
        r = ctl({"cmd": "ping"}, 3)
    except Sandboxed:
        r = "sandboxed"
    if r == "sandboxed":
        row("hub", "socket blocked by sandbox (pb send uses the output channel)")
    elif r:
        row("hub", f"up pid={r.get('pid')} v={r.get('version')} codex={'connected' if r.get('codex') else 'NOT connected'} bridged={len(r.get('threads') or [])}")
    else:
        row("hub", "NOT running (pb ensure)")
    tid = os.environ.get("CODEX_THREAD_ID")
    row("this codex thread", tid or "- (not inside Codex)")
    print("\n".join(o.encode("ascii", "replace").decode() for o in out))


def cmd_policy(args):
    print(json.dumps(policy.load(), indent=1))


def cmd_expose(args, hide=False):
    p = policy.load()
    kind, val = _target(args)
    if kind == "all":
        p["expose"] = "optin" if hide else "all"
    else:
        key = "threads" if kind == "thread" else "cwds"
        cur = [x for x in (p.get(key) or []) if x != val]
        p[key] = cur if hide else cur + [val]
    policy.save(p)
    print(json.dumps(policy.load(), indent=1))


def cmd_off(args, off=True):
    p = policy.load()
    p["off"] = off
    policy.save(p)
    print("peerbridge OFF: every Codex peer withdrawn within ~1 s, all injection refused" if off else "peerbridge ON")


def main():
    try:
        _main()
    except Sandboxed:
        die("the Codex sandbox blocked the peerbridge socket (Operation not permitted). "
            "Re-run this exact pb command with escalated permissions (sandbox_permissions=require_escalated); "
            "do NOT run `pb ensure` - the hub is already running.", 3)


def _main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmds = {"list": cmd_list, "ls": cmd_list, "send": cmd_send, "whoami": cmd_whoami, "name": cmd_name,
            "ensure": lambda a: ensure(quiet=True) if "--quiet" in a else print(json.dumps(ensure(), indent=1)), "status": cmd_status, "stop": cmd_stop,
            "policy": cmd_policy, "doctor": cmd_doctor, "expose": cmd_expose, "hide": lambda a: cmd_expose(a, hide=True),
            "off": cmd_off, "on": lambda a: cmd_off(a, off=False)}
    if a[0] not in cmds:
        die(f"unknown command {a[0]}\n{__doc__}")
    cmds[a[0]](a[1:])


if __name__ == "__main__":
    main()
